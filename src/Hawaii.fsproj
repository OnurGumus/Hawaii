<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Unofficial modernized fork of Hawaii - a dotnet CLI tool that generates type-safe F# and Fable clients from OpenAPI/Swagger/OData. Targets .NET 10, reads OpenAPI 2.0/3.0/3.1/3.2, and generates System.Text.Json (F#) / Thoth.Json (Fable) clients. Not affiliated with the original project.</Description>
    <OutputType>Exe</OutputType>
    <ToolCommandName>hawaii-unofficial</ToolCommandName>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <IsPackable>true</IsPackable>
    <RollForward>Major</RollForward>
    <PackageId>Hawaii.Unofficial</PackageId>
    <Version>1.0.0</Version>
    <Authors>Zaid Ajaj (original author), Onur Gumus (fork)</Authors>
    <PackageProjectUrl>https://github.com/OnurGumus/Hawaii</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OnurGumus/Hawaii</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>fsharp;fable;openapi;swagger;odata;codegen;client</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Unofficial modernized fork. .NET 10; Microsoft.OpenApi 3.x (reads OpenAPI 2.0/3.0/3.1/3.2, incl. the QUERY method); Fantomas 7; System.Text.Json for the F# target and Thoth.Json for the Fable target; discriminated unions generated from oneOf+discriminator schemas; OPTIONS/TRACE/QUERY HTTP methods; opt-in response headers and streaming responses; TimeSpan support; plus assorted codegen fixes.</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />
    <Content Include="./storage.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="./hawaii.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="./appinsights.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="schemas\select.json" />
    <Content Include="schemas\SelectFull.json" />
    <Content Include="schemas\twinehealth.json" />
    <Content Include="schemas\watchful.json" />
    <Content Include="./schemas/petstore-modified.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="./schemas/ghibli.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="./schemas/simple-nswag.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="./schemas/simple-swashbuckle.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="./schemas/esight.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="./schemas/nswag-with-files.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="schemas\petstore-v3.json" />
    <Content Include="schemas\Podiosuite.json" />
    <Content Include="schemas\SwashbuckleTime.json" />
    <Content Include="schemas\UnlimitedResponses.json" />
    <Compile Include="./FsAst/AstRcd.fs" />
    <Compile Include="./FsAst/AstCreate.fs" />
    <Compile Include="HttpLibrary.fs" />
    <Compile Include="Extensions.fs" />
    <Compile Include="CodeGen.fs" />
    <Compile Include="Helpers.fs" />
    <Compile Include="Domain.fs" />
    <Compile Include="OperationParameters.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Fantomas.Core" Version="7.0.5" />
    <PackageReference Include="Microsoft.OpenApi" Version="3.5.3" />
    <PackageReference Include="Microsoft.OpenApi.OData" Version="3.2.1" />
    <PackageReference Include="Microsoft.OpenApi.YamlReader" Version="3.5.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>
</Project>